table daily
	lineageTag: 973a0620-4ae1-4f8c-afed-0bcd5b9de6b2

	measure 'Total Requests' = SUM('daily'[requests])
		formatString: #,0
		lineageTag: 717e5e7f-023b-4255-8f13-1cf96461b4c2

	measure 'Closed Requests' = SUM('daily'[closed_requests])
		formatString: #,0
		lineageTag: c7adb0ab-1eb1-4bf8-a424-b64688445818

	measure 'Not Closed Requests' = [Total Requests] - [Closed Requests]
		formatString: #,0
		lineageTag: e685070c-7879-4c5a-b278-5268ab01ee37

	measure 'Closure Rate' = DIVIDE([Closed Requests], [Total Requests], 0)
		formatString: 0.00%
		lineageTag: e500d13c-b9d8-4555-924c-9791d32c50ca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column day
		dataType: dateTime
		formatString: Long Date
		lineageTag: deadb709-f210-40d5-b081-51e7e2f0e65d
