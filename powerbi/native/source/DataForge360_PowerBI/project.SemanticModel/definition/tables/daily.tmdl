			defaultHierarchy: LocalDateTable_1c73d932-0fbb-4f1a-98a5-52228097014d.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column day_label
