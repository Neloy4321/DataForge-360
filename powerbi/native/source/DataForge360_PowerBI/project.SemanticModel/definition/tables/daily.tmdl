		formatString: #,0
		lineageTag: ed427c20-33df-47af-8f3e-e4690e93ea4c
		summarizeBy: sum
		sourceColumn: requests

		annotation SummarizationSetBy = Automatic

	column closed_requests
		dataType: int64
		formatString: #,0
		lineageTag: e8c2525a-c1b8-426a-922f-66b6f375b456
		summarizeBy: sum
		sourceColumn: closed_requests

		annotation SummarizationSetBy = Automatic

	partition daily = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\DataForge360\data\dataforge_daily_2026-09-01_2026-09-05.csv"),[Delimiter=",", Columns=3, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
